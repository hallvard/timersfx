<?xml version="1.0" encoding="UTF-8"?>

<?import org.kordamp.ikonli.javafx.FontIcon?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fx/1" stylesheets="@TimersFxApp.css" fx:controller="no.hal.timers.fx.EventListController">
  <top>
    <VBox>
      <HBox styleClass="spacer">
        <Label text="%eventListTitle.text" styleClass="header"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="newEventButton" onAction="#handleNew">
          <graphic>
            <FontIcon iconLiteral="mdi2p-plus-thick:24"/>
          </graphic>
        </Button>
      </HBox>
      <!-- asks for the location, for a new event, a copy or a new name, here and not in a dialog, which does not work well in the native app -->
      <VBox fx:id="promptBox" visible="false" managed="false" styleClass="container">
        <Label fx:id="promptLabel"/>
        <HBox styleClass="spacer">
          <Label fx:id="datePrefixLabel"/>
          <TextField fx:id="locationField" promptText="%locationField.promptText" onAction="#handleConfirmPrompt" HBox.hgrow="ALWAYS"/>
          <Button onAction="#handleConfirmPrompt">
            <graphic>
              <FontIcon iconLiteral="mdi2c-check:24:green"/>
            </graphic>
          </Button>
          <Button onAction="#handleCancelPrompt">
            <graphic>
              <FontIcon iconLiteral="mdi2c-close:24:red"/>
            </graphic>
          </Button>
        </HBox>
        <Label fx:id="promptErrorLabel" visible="false" managed="false" styleClass="error"/>
      </VBox>
    </VBox>
  </top>
  <center>
    <ScrollPane vbarPolicy="AS_NEEDED" hbarPolicy="NEVER" fitToWidth="true">
      <VBox>
        <Label fx:id="noEventsLabel" text="%noEvents.text" styleClass="container"/>
        <VBox fx:id="eventList" styleClass="container"/>
      </VBox>
    </ScrollPane>
  </center>
</BorderPane>
